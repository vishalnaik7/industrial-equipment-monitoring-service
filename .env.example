# Copy to .env and adjust. Docker Compose reads .env automatically for the variables used in docker-compose.yml.
# For a local (non-Docker) run, set variables in your shell instead (the backend reads the process environment).

# Comma-separated API keys. Empty = authentication disabled (development only).
API_KEYS=

# Demo only: the supplied data is dated April 2026, so with the default (30) every machine is reported as stale.
STALE_AFTER_MINUTES=30

# Browser origins allowed to call the API directly (not needed behind the nginx proxy or the Vite dev proxy).
CORS_ORIGINS=

# Other backend settings (shown with their defaults; used by local runs - add them to docker-compose.yml to use in Docker):
# DB_PATH=backend/data/monitoring.db
# MAINTAFLOW_TZ=UTC
# FUTURE_TOLERANCE_MINUTES=10
# RELEVANCE_WINDOW_MINUTES=60
# MAX_ATTEMPTS=5
# RETRY_BASE_SECONDS=5
# LEASE_SECONDS=60
# MAX_RECORDS_PER_BATCH=5000
# MAX_BODY_BYTES=5242880
