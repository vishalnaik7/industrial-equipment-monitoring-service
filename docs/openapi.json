    "/v1/ingest/{vendor}": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest Vendor",
        "description": "Accept a vendor batch (pulseforge | thermexwatch | maintaflow). Returns 202 + batch_id immediately;\nnormalization and state derivation happen asynchronously. Replaying an identical body returns 200.",
